(    def get_user_by_email_password\(self, email, password\):) Tj
T*
(        """이메일과 비밀번호로 사용자 조회 \(Folder 테이블\)""") Tj
T*
(        if self.use_supabase:) Tj
T*
(            try:) Tj
T*
(                result = self.supabase.table\('Folder'\).select\('*'\).eq\('email', email\).eq\('password', password\).execute\(\)) Tj
T*
(                if result.data and len\(result.data\) > 0:) Tj
T*
(                    return result.data[0]  # 첫 번째 매칭되는 폴더 반환) Tj
T*
(                return None) Tj
T*
(            except Exception as e:) Tj
T*
(                print\(f"사용자 조회 오류: {e}"\)) Tj
T*
(                return None) Tj
T*
(        else:) Tj
T*
(            # JSON 폴백 모드) Tj
T*
(            for folder_id, folder_data in self._folders.items\(\):) Tj
T*
(                if folder_data.get\('email'\) == email and folder_data.get\('password'\) == password:) Tj
T*
(                    return folder_data) Tj
T*
(            return None) Tj
T*
(    ) Tj
