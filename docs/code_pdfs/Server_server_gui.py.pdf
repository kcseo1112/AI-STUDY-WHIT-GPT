T*
(    def start_server\(self\):) Tj
T*
(        if self.server_thread and self.server_thread.is_alive\(\):) Tj
T*
(            messagebox.showinfo\("알림", "이미 서버가 실행 중입니다."\)) Tj
T*
(            return) Tj
T*
() Tj
T*
(        host = self.host_entry.get\(\).strip\(\) or DEFAULT_HOST) Tj
T*
(        try:) Tj
T*
(            port = int\(self.port_entry.get\(\).strip\(\) or DEFAULT_PORT\)) Tj
T*
(        except ValueError:) Tj
T*
(            messagebox.showerror\("오류", "포트는 숫자여야 합니다."\)) Tj
T*
(            return) Tj
T*
() Tj
T*
(        self.server = AILearningServer\(host=host, port=port, log_callback=self._log\)) Tj
T*
() Tj
T*
(        def run_server\(\):) Tj
T*
(            self._log\(f"[서버] 시작: {host}:{port}"\)) Tj
T*
(            self._set_status\(running=True, host=host, port=port\)) Tj
T*
(            try:) Tj
T*
(                self.server.start\(\)) Tj
T*
(            finally:) Tj
T*
(                self._set_status\(running=False\)) Tj
T*
(                self._log\("[서버] 중지됨"\)) Tj
T*
(                self._update_client_list\(\)) Tj
T*
() Tj
T*
(        self.server_thread = threading.Thread\(target=run_server, daemon=True\)) Tj
T*
(        self.server_thread.start\(\)) Tj
T*
() Tj
T*
(        self.start_btn.config\(state="disabled"\)) Tj
T*
(        self.stop_btn.config\(state="normal"\)) Tj
T*
() Tj
T*
(    def stop_server\(self\):) Tj
T*
(        if self.server:) Tj
T*
(            self.server.stop\(\)) Tj
T*
(        self.start_btn.config\(state="normal"\)) Tj
T*
(        self.stop_btn.config\(state="disabled"\)) Tj
T*
() Tj
T*
(    # --- UI 업데이트 ---) Tj
T*
() Tj
T*
(    def _log\(self, msg: str\):) Tj
