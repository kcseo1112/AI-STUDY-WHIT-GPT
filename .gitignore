# ============================================
# Python 관련
# ============================================
# Python 캐시 파일
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 가상환경
venv/
env/
ENV/
.venv
venv.bak/

# ============================================
# 환경 변수 및 설정 파일 (민감 정보)
# ============================================
.env
.env.local
.env.*.local
*.env

# ============================================
# 데이터 파일 (서버에서 자동 생성)
# ============================================
# 서버가 받은 파일 저장 디렉토리
received_files/

# JSON 폴백 모드 데이터 파일
data/
*.json
!package.json
!package-lock.json

# ============================================
# 미디어 파일 (용량이 큰 파일)
# ============================================
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.avi
*.mp4
*.mov

# ============================================
# IDE 및 에디터 설정
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ============================================
# OS 관련 파일
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================
# 로그 및 임시 파일
# ============================================
*.log
*.tmp
*.bak
*.cache
*.pid
*.seed
*.pid.lock

# ============================================
# 빌드 및 배포 파일
# ============================================
dist/
build/
*.egg-info/
.eggs/

# ============================================
# 테스트 관련 (선택사항)
# ============================================
# 테스트 폴더는 실행에 필요하므로 포함
# 단, 테스트 폴더 내의 미디어 파일(.wav 등)은 위의 규칙에 의해 무시됨
