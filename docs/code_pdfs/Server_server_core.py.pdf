(        try:) Tj
T*
(            # 파일명 수신) Tj
T*
(            filename_data = b"") Tj
T*
(            while True:) Tj
T*
(                chunk = conn.recv\(1\)) Tj
T*
(                if not chunk:) Tj
T*
(                    return False) Tj
T*
(                if chunk == b'\\0':) Tj
T*
