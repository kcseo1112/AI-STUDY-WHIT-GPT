(    ) Tj
T*
(    def __init__\(self, host=DEFAULT_HOST, port=DEFAULT_PORT, log_callback=None\):) Tj
T*
(        self.host = host) Tj
T*
(        self.port = port) Tj
T*
(        self.server_socket = None) Tj
T*
(        self.is_running = False) Tj
T*
(        self.log_callback = log_callback) Tj
T*
(        self.connected_clients = {}) Tj
T*
(        ) Tj
T*
(        # 데이터 관리자 및 핸들러 초기화) Tj
T*
(        self.data_manager = ServerDataManager\(\)) Tj
T*
(        self.handlers = ServerCommandHandlers\(self.data_manager, log_callback\)) Tj
T*
(        ) Tj
T*
(        # 디렉토리 생성) Tj
T*
(        os.makedirs\(RECEIVE_DIR, exist_ok=True\)) Tj
T*
(    ) Tj
T*
(    def _log\(self, message\):) Tj
T*
(        """로그 출력 \(콘솔 또는 GUI\)""") Tj
T*
