(    def handle_save_text\(self, data\):) Tj
T*
(        """클라이언트에서 변환된 텍스트를 서버에 저장 \(File 테이블만 사용\)""") Tj
T*
(        filename = data.get\("filename"\)) Tj
T*
(        text = data.get\("text", ""\)) Tj
T*
(        keywords = data.get\("keywords", ""\)) Tj
T*
(        summary = data.get\("summary", ""\)) Tj
T*
(        ) Tj
T*
(        if not filename:) Tj
T*
(            return {"status": "error", "message": "파일명이 제공되지 않았습니다."}) Tj
T*
(        ) Tj
T*
(        if not text:) Tj
T*
(            return {"status": "error", "message": "텍스트가 비어있습니다."}) Tj
T*
(        ) Tj
T*
(        try:) Tj
T*
(            base_name, _ = os.path.splitext\(filename\)) Tj
T*
(            ) Tj
T*
(            # 1\) 원본 텍스트 파일 저장) Tj
T*
(            text_file = os.path.join\(RECEIVE_DIR, f"{base_name}.txt"\)) Tj
T*
(            with open\(text_file, 'w', encoding='utf-8'\) as f:) Tj
T*
(                f.write\(text\)) Tj
T*
(            ) Tj
T*
(            self._log\(f"텍스트 저장 완료: {text_file}"\)) Tj
T*
(            ) Tj
T*
(            # 2\) 요약 파일 경로 생성 \(클라이언트에서 전송한 키워드/요약 사용\)) Tj
T*
(            summary_file_path = None) Tj
T*
(            if keywords or summary:) Tj
T*
(                summary_filename = f"{base_name}_sub.txt") Tj
T*
(                summary_file_path = os.path.join\(RECEIVE_DIR, summary_filename\)) Tj
T*
(                with open\(summary_file_path, 'w', encoding='utf-8'\) as f:) Tj
T*
(                    if keywords:) Tj
T*
(                        f.write\("[키워드]\\n"\)) Tj
T*
(                        f.write\(keywords + "\\n\\n"\)) Tj
T*
(                    if summary:) Tj
T*
(                        f.write\("[요약]\\n"\)) Tj
T*
(                        f.write\(summary\)) Tj
T*
(            ) Tj
T*
(            # File 테이블에 파일 등록 \(folder_id는 NULL로 설정 - 단일 사용자 프로젝트\)) Tj
T*
(            # keywords와 summary는 summary_file_path 파일에만 저장 \(테이블 컬럼 사용 안 함\)) Tj
T*
(            file_data = self.data_manager.create_file\() Tj
T*
(                folder_id=None,  # 단일 사용자 프로젝트이므로 folder_id 불필요) Tj
T*
ET
