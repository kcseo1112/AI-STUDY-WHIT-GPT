T*
(def get_openai_api_key\(\):) Tj
T*
(    return os.getenv\('OPENAI_API_KEY', ''\)  # OpenAI는 선택사항이므로 빈 문자열 허용) Tj
T*
() Tj
T*
(def get_openai_model\(\):) Tj
T*
(    value = os.getenv\('OPENAI_MODEL'\)) Tj
T*
(    if value is None:) Tj
T*
(        raise ValueError\("OPENAI_MODEL이 .env 파일에 설정되어 있지 않습니다."\)) Tj
T*
(    return value) Tj
T*
