(class AILearningGUI:) Tj
T*
(    """AI 학습 지원 GUI 클라이언트""") Tj
T*
(    ) Tj
T*
(    def __init__\(self, root\):) Tj
T*
(        self.root = root) Tj
T*
(        ) Tj
T*
(        # TCP 클라이언트) Tj
T*
(        self.tcp_client = TCPClient\(\)) Tj
T*
(        ) Tj
T*
(        # UI 구성) Tj
T*
(        self.ui = ClientUI\(root\)) Tj
T*
(        ) Tj
T*
(        # 이벤트 핸들러) Tj
T*
(        self.handlers = ClientHandlers\(self.ui, self.tcp_client\)) Tj
T*
(        ) Tj
T*
(        # UI에 root 참조 추가 \(핸들러에서 사용\)) Tj
T*
(        self.ui.root = root) Tj
T*
(        ) Tj
T*
(        # 기본 사용자 설정 \(로그인 없이\)) Tj
T*
(        self.handlers.current_user_email = "user@example.com") Tj
T*
(        self.ui.current_user_email = "user@example.com") Tj
T*
(        self.ui.current_username = "user") Tj
T*
(        self.ui.is_logged_in = True) Tj
T*
(        ) Tj
T*
(        # 서버 자동 연결 및 파일 목록 로드) Tj
T*
(        self._auto_connect_server\(\)) Tj
T*
(    ) Tj
T*
(    def _auto_connect_server\(self\):) Tj
T*
(        """서버 자동 연결 및 파일 목록 로드""") Tj
T*
(        from env_utils import DEFAULT_HOST, DEFAULT_PORT) Tj
T*
(        ) Tj
T*
(        # UI 업데이트를 위해 after 사용) Tj
T*
(        def connect\(\):) Tj
T*
(            if self.tcp_client.connect\(DEFAULT_HOST, DEFAULT_PORT\):) Tj
T*
(                self.ui.server_status_label.config\() Tj
T*
(                    text=f"연결 상태: 연결됨 \({DEFAULT_HOST}:{DEFAULT_PORT}\)", ) Tj
T*
(                    fg='green') Tj
T*
(                \)) Tj
T*
