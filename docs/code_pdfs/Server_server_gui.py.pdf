(        def append\(\):) Tj
T*
(            self.log_text.config\(state="normal"\)) Tj
T*
(            self.log_text.insert\("end", msg + "\\n"\)) Tj
T*
(            self.log_text.see\("end"\)) Tj
T*
(            self.log_text.config\(state="disabled"\)) Tj
T*
(            ) Tj
T*
(            # 클라이언트 연결/종료 메시지 파싱) Tj
T*
(            if "[연결] 클라이언트:" in msg:) Tj
T*
(                parts = msg.split\("클라이언트:"\)) Tj
T*
(                if len\(parts\) > 1:) Tj
T*
(                    client_id = parts[1].strip\(\)) Tj
T*
(                    self.connected_clients[client_id] = client_id) Tj
T*
(                    self._update_client_list\(\)) Tj
T*
(            elif "[종료] 클라이언트 연결 종료:" in msg:) Tj
T*
(                parts = msg.split\("클라이언트 연결 종료:"\)) Tj
T*
(                if len\(parts\) > 1:) Tj
T*
(                    client_id = parts[1].strip\(\)) Tj
T*
(                    if client_id in self.connected_clients:) Tj
T*
(                        del self.connected_clients[client_id]) Tj
T*
(                    self._update_client_list\(\)) Tj
T*
() Tj
T*
(        self.root.after\(0, append\)) Tj
T*
(    ) Tj
T*
(    def _update_client_list\(self\):) Tj
T*
(        """연결된 클라이언트 목록 업데이트""") Tj
T*
(        def update\(\):) Tj
T*
(            self.client_listbox.delete\(0, tk.END\)) Tj
T*
(            for client_id in self.connected_clients.values\(\):) Tj
T*
(                self.client_listbox.insert\(tk.END, client_id\)) Tj
T*
(            self.client_count_label.config\(text=f"접속 클라이언트: {len\(self.connected_clients\)}명"\)) Tj
T*
(        ) Tj
T*
(        self.root.after\(0, update\)) Tj
T*
() Tj
T*
(    def _set_status\(self, running: bool, host: str | None = None, port: int | None = None\):) Tj
T*
(        def update\(\):) Tj
T*
(            if running:) Tj
T*
(                self.status_label.config\() Tj
T*
(                    text=f"상태: 실행 중 \({host}:{port}\)", foreground="green") Tj
T*
(                \)) Tj
T*
(            else:) Tj
T*
(                self.status_label.config\(text="상태: 중지됨", foreground="red"\)) Tj
T*
() Tj
T*
(        self.root.after\(0, update\)) Tj
T*
() Tj
T*
() Tj
T*
