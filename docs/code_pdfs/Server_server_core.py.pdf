T*
(    ) Tj
T*
(    def handle_command\(self, conn\):) Tj
T*
(        """명령 메시지 처리""") Tj
T*
(        try:) Tj
T*
(            # STT 처리를 위해 타임아웃 증가) Tj
T*
(            conn.settimeout\(300.0\)  # 5분 타임아웃) Tj
T*
(            ) Tj
T*
(            # 메시지 길이 수신 \(4바이트\)) Tj
T*
(            length_bytes = conn.recv\(4\)) Tj
T*
(            if len\(length_bytes\) != 4:) Tj
T*
(                return) Tj
T*
(            ) Tj
T*
(            message_length = int.from_bytes\(length_bytes, byteorder='big'\)) Tj
T*
(            ) Tj
T*
(            # 메시지 본문 수신) Tj
T*
(            message_data = b"") Tj
T*
(            while len\(message_data\) < message_length:) Tj
T*
(                chunk = conn.recv\(min\(BUFSIZE, message_length - len\(message_data\)\)\)) Tj
T*
(                if not chunk:) Tj
T*
(                    return) Tj
T*
(                message_data += chunk) Tj
T*
(            ) Tj
T*
(            if len\(message_data\) < message_length:) Tj
T*
(                return) Tj
T*
(            ) Tj
T*
(            # JSON 파싱) Tj
T*
(            try:) Tj
T*
(                message = json.loads\(message_data.decode\('utf-8'\)\)) Tj
T*
(                command = message.get\("command"\)) Tj
T*
(                data = message.get\("data", {}\)) Tj
T*
(                ) Tj
T*
(                # 명령 처리) Tj
T*
(                response = self.process_command\(command, data, conn\)) Tj
T*
(                ) Tj
T*
(                # 응답 전송) Tj
T*
(                response_json = json.dumps\(response, ensure_ascii=False\)) Tj
T*
ET
endstream
