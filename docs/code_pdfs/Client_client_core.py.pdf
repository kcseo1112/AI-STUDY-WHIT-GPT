(        try:) Tj
T*
(            payload = {) Tj
T*
(                "command": command,) Tj
T*
(                "data": data or {}) Tj
T*
(            }) Tj
T*
(            body = json.dumps\(payload, ensure_ascii=False\).encode\("utf-8"\)) Tj
T*
(            header = len\(body\).to_bytes\(4, byteorder="big"\)) Tj
T*
() Tj
T*
(            with self.lock:) Tj
T*
(                # STT 처리는 OpenAI API 호출로 시간이 걸릴 수 있으므로 타임아웃 증가) Tj
T*
(                with socket.create_connection\(\(self.host, self.port\), timeout=300\) as sock:) Tj
T*
(                    # 전송) Tj
T*
(                    sock.sendall\(header\)) Tj
T*
(                    sock.sendall\(body\)) Tj
T*
() Tj
T*
(                    # 응답 수신 \(STT 처리 시간 고려하여 타임아웃 증가\)) Tj
T*
(                    sock.settimeout\(300.0\)  # 5분 타임아웃) Tj
T*
(                    length_bytes = sock.recv\(4\)) Tj
T*
(                    if len\(length_bytes\) != 4:) Tj
T*
(                        return {"status": "error", "message": "응답 길이 수신 실패"}) Tj
T*
() Tj
T*
(                    resp_len = int.from_bytes\(length_bytes, byteorder="big"\)) Tj
T*
(                    resp_data = b"") Tj
T*
(                    while len\(resp_data\) < resp_len:) Tj
T*
(                        chunk = sock.recv\(min\(BUFSIZE, resp_len - len\(resp_data\)\)\)) Tj
T*
(                        if not chunk:) Tj
T*
(                            break) Tj
T*
(                        resp_data += chunk) Tj
T*
() Tj
T*
(            if len\(resp_data\) < resp_len:) Tj
T*
(                return {"status": "error", "message": "응답 데이터 부족"}) Tj
T*
() Tj
T*
(            return json.loads\(resp_data.decode\("utf-8"\)\)) Tj
T*
() Tj
T*
(        except Exception as e:) Tj
T*
(            return {"status": "error", "message": str\(e\)}) Tj
T*
() Tj
T*
(    def send_file\(self, file_path\):) Tj
T*
(        """파일 전송 \(요청당 새 소켓 사용\)""") Tj
T*
(        try:) Tj
T*
(            self._ensure_target\(\)) Tj
T*
(        except RuntimeError as e:) Tj
T*
(            return {"status": "error", "message": str\(e\)}) Tj
T*
() Tj
T*
(        try:) Tj
T*
(            if not os.path.exists\(file_path\):) Tj
T*
(                return {"status": "error", "message": "파일을 찾을 수 없습니다."}) Tj
T*
() Tj
T*
(            file_size = os.path.getsize\(file_path\)) Tj
T*
(            filename = os.path.basename\(file_path\)) Tj
T*
() Tj
T*
(            with self.lock:) Tj
T*
(                # 파일 전송은 큰 파일도 고려하여 타임아웃 증가) Tj
T*
(                with socket.create_connection\(\(self.host, self.port\), timeout=300\) as sock:) Tj
T*
(                    sock.settimeout\(300.0\)  # 5분 타임아웃) Tj
T*
