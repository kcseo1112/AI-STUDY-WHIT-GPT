T*
(    ) Tj
T*
(    def _init_json_fallback\(self\):) Tj
T*
(        """JSON 파일 폴백 모드 초기화""") Tj
T*
(        from env_utils import DATA_DIR) Tj
T*
(        self.folders_file = os.path.join\(DATA_DIR, "folders.json"\)) Tj
T*
(        self.files_file = os.path.join\(DATA_DIR, "files.json"\)) Tj
T*
(        self.quizzes_file = os.path.join\(DATA_DIR, "quizzes.json"\)) Tj
T*
(        os.makedirs\(DATA_DIR, exist_ok=True\)) Tj
T*
(        self.load_data\(\)) Tj
T*
(    ) Tj
T*
(    def load_data\(self\):) Tj
T*
(        """데이터 로드 \(JSON 폴백용\)""") Tj
T*
(        if self.use_supabase:) Tj
T*
(            return  # Supabase는 실시간으로 데이터를 가져오므로 로드 불필요) Tj
T*
(        ) Tj
T*
(        # JSON 폴백 모드) Tj
T*
(        if os.path.exists\(self.folders_file\):) Tj
T*
(            with open\(self.folders_file, 'r', encoding='utf-8'\) as f:) Tj
T*
(                self._folders = json.load\(f\)) Tj
T*
(        else:) Tj
T*
(            self._folders = {}) Tj
T*
(        ) Tj
T*
(        if os.path.exists\(self.files_file\):) Tj
T*
(            with open\(self.files_file, 'r', encoding='utf-8'\) as f:) Tj
T*
(                self._files = json.load\(f\)) Tj
T*
(        else:) Tj
T*
(            self._files = {}) Tj
T*
(        ) Tj
T*
(        if os.path.exists\(self.quizzes_file\):) Tj
T*
(            with open\(self.quizzes_file, 'r', encoding='utf-8'\) as f:) Tj
T*
(                self._quizzes = json.load\(f\)) Tj
T*
