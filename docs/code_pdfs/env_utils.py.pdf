T*
(def get_whisper_model\(\):) Tj
T*
(    """Whisper 모델 설정 \(OpenAI Whisper API는 'whisper-1'만 사용, 호환성을 위해 유지\)""") Tj
T*
(    # OpenAI Whisper API는 'whisper-1' 모델만 사용하므로 기본값 반환) Tj
T*
(    return os.getenv\('WHISPER_MODEL', 'whisper-1'\)) Tj
T*
() Tj
T*
(def get_whisper_language\(\):) Tj
T*
(    """Whisper 언어 설정 \(선택사항, 없으면 자동 감지\)""") Tj
T*
(    # OpenAI Whisper API는 language가 없으면 자동 감지하므로 선택사항) Tj
T*
(    return os.getenv\('WHISPER_LANGUAGE', None\)) Tj
T*
() Tj
T*
(# 호환성을 위한 상수 \(기존 코드와의 호환\)) Tj
T*
(DEFAULT_HOST = get_default_host\(\)) Tj
T*
(DEFAULT_PORT = get_default_port\(\)) Tj
T*
(BUFSIZE = get_bufsize\(\)) Tj
T*
(RECEIVE_DIR = get_receive_dir\(\)) Tj
T*
