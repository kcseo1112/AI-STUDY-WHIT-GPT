(    def handle_login\(self, data\):) Tj
T*
(        """로그인 처리 \(Folder 테이블 기반\)""") Tj
T*
(        username = data.get\("username", ""\)) Tj
T*
(        email = data.get\("email"\)) Tj
T*
(        password = data.get\("password", ""\)) Tj
T*
(        ) Tj
T*
(        if not email:) Tj
T*
(            return {"status": "error", "message": "이메일을 입력해주세요."}) Tj
T*
(        ) Tj
T*
(        # 사용자명이 없으면 이메일에서 추출) Tj
T*
(        if not username:) Tj
T*
(            username = email.split\('@'\)[0]) Tj
T*
(        ) Tj
T*
(        # 비밀번호가 없으면 빈 문자열로 처리 \(선택사항\)) Tj
T*
(        if not password:) Tj
T*
(            password = "") Tj
T*
(        ) Tj
T*
(        # Folder 테이블에서 이메일과 비밀번호로 사용자 확인) Tj
T*
(        user = self.data_manager.get_user_by_email_password\(email, password\)) Tj
T*
(        ) Tj
T*
(        if user:) Tj
T*
(            # 로그인 성공) Tj
T*
(            return {) Tj
T*
(                "status": "success",) Tj
T*
(                "message": "로그인 성공",) Tj
T*
(                "user": {) Tj
T*
(                    "folder_id": user.get\("folder_id"\),) Tj
T*
(                    "user_name": user.get\("user_name"\),) Tj
T*
(                    "email": user.get\("email"\)) Tj
T*
(                }) Tj
T*
(            }) Tj
T*
(        else:) Tj
T*
(            # 새 사용자 등록 - 기본 폴더와 함께 생성) Tj
T*
(            new_folder = self.data_manager.create_user_with_default_folder\() Tj
T*
(                username=username,) Tj
T*
(                email=email,) Tj
T*
(                password=password,) Tj
T*
ET
