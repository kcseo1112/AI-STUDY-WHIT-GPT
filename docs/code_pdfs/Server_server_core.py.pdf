T*
(            self.log_callback\(message\)) Tj
T*
(        else:) Tj
T*
(            print\(message\)) Tj
T*
(    ) Tj
T*
(    def start\(self\):) Tj
T*
(        """서버 시작""") Tj
T*
(        try:) Tj
T*
(            self.server_socket = socket.socket\(socket.AF_INET, socket.SOCK_STREAM\)) Tj
T*
(            self.server_socket.setsockopt\(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1\)) Tj
T*
(            self.server_socket.bind\(\(self.host, self.port\)\)) Tj
T*
