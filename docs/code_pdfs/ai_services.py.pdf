T*
(        elif "rate_limit" in str\(e\).lower\(\):) Tj
T*
(            error_msg += "\\n\\nAPI 사용량 제한에 도달했습니다. 잠시 후 다시 시도해주세요.") Tj
T*
(        raise RuntimeError\(error_msg\) from e) Tj
