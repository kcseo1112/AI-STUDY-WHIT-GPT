(import json) Tj
T*
(import socket) Tj
T*
(import threading) Tj
T*
(import os) Tj
T*
(import sys) Tj
T*
(sys.path.append\(os.path.dirname\(os.path.dirname\(os.path.abspath\(__file__\)\)\)\)) Tj
T*
(from env_utils import DEFAULT_HOST, DEFAULT_PORT, BUFSIZE) Tj
T*
() Tj
T*
() Tj
T*
(class TCPClient:) Tj
T*
(    """TCP/IP 소켓 클라이언트 \(요청당 새 연결 방식\)""") Tj
T*
() Tj
T*
(    def __init__\(self\):) Tj
T*
(        self.lock = threading.Lock\(\)) Tj
T*
(        self.is_connected = False) Tj
T*
(        self.host = None) Tj
T*
(        self.port = None) Tj
T*
() Tj
T*
(    def connect\(self, host, port\):) Tj
T*
(        """서버 연결 테스트 후 호스트/포트만 기억""") Tj
T*
(        try:) Tj
T*
(            # 한 번만 테스트 연결) Tj
T*
(            with socket.create_connection\(\(host, port\), timeout=5\):) Tj
T*
(                pass) Tj
T*
(            with self.lock:) Tj
T*
(                self.host = host) Tj
T*
(                self.port = port) Tj
T*
(                self.is_connected = True) Tj
T*
(            return True) Tj
T*
(        except Exception as e:) Tj
T*
(            print\(f"연결 실패: {e}"\)) Tj
T*
(            return False) Tj
T*
() Tj
T*
(    def disconnect\(self\):) Tj
T*
(        """서버 연결 해제 \(논리적 연결만 해제\)""") Tj
T*
(        with self.lock:) Tj
T*
(            self.host = None) Tj
T*
(            self.port = None) Tj
T*
(            self.is_connected = False) Tj
T*
() Tj
T*
(    def _ensure_target\(self\):) Tj
T*
(        if not self.is_connected or not self.host or not self.port:) Tj
T*
(            raise RuntimeError\("서버에 연결되어 있지 않습니다."\)) Tj
T*
() Tj
T*
(    def send_command\(self, command, data=None\):) Tj
T*
(        """서버에 명령 전송 \(요청당 새 소켓 사용\)""") Tj
T*
(        try:) Tj
T*
(            self._ensure_target\(\)) Tj
T*
(        except RuntimeError as e:) Tj
T*
(            return {"status": "error", "message": str\(e\)}) Tj
T*
() Tj
T*
ET
