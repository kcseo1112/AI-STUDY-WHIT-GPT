(def add_file_to_pdf\(file_path: Path\) -> Path:) Tj
T*
(    try:) Tj
T*
(        content = file_path.read_text\(encoding="utf-8"\)) Tj
T*
(    except UnicodeDecodeError:) Tj
T*
(        content = file_path.read_text\(encoding="utf-8", errors="replace"\)) Tj
T*
(    lines = [f"Path: {file_path.relative_to\(REPO_ROOT\)}"] + content.splitlines\(\)) Tj
T*
(    page_chunks = chunk_lines\(lines, MAX_LINES_PER_PAGE\)) Tj
T*
(    pdf_bytes = build_pdf\(page_chunks, title=str\(file_path.relative_to\(REPO_ROOT\)\)\)) Tj
T*
(    output_path = OUTPUT_DIR / f"{file_path.relative_to\(REPO_ROOT\).as_posix\(\).replace\('/', '_'\)}.pdf") Tj
T*
(    output_path.parent.mkdir\(parents=True, exist_ok=True\)) Tj
T*
(    output_path.write_bytes\(pdf_bytes\)) Tj
T*
(    return output_path) Tj
T*
() Tj
T*
() Tj
T*
(def main\(\):) Tj
T*
(    OUTPUT_DIR.mkdir\(parents=True, exist_ok=True\)) Tj
T*
(    for file_path in iter_text_files\(REPO_ROOT\):) Tj
T*
(        output = add_file_to_pdf\(file_path\)) Tj
T*
(        print\(f"Generated {output}"\)) Tj
T*
() Tj
T*
() Tj
