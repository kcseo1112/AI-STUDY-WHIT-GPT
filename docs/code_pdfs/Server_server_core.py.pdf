(                return self.handlers.handle_login\(data\)) Tj
T*
(            elif command == "convert_audio":) Tj
T*
(                return self.handlers.handle_convert_audio\(data\)) Tj
T*
(            elif command == "save_text":) Tj
T*
(                return self.handlers.handle_save_text\(data\)) Tj
T*
(            elif command == "manage_folder":) Tj
T*
(                return self.handlers.handle_manage_folder\(data\)) Tj
T*
