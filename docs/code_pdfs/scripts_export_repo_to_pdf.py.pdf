(def iter_text_files\(root: Path\) -> Iterable[Path]:) Tj
T*
(    for dirpath, dirnames, filenames in os.walk\(root\):) Tj
T*
(        rel_dir = Path\(dirpath\).relative_to\(root\)) Tj
T*
(        if any\(part in EXCLUDE_DIRS for part in rel_dir.parts\):) Tj
T*
(            dirnames[:] = []) Tj
T*
(            continue) Tj
T*
(        dirnames[:] = [d for d in dirnames if d not in EXCLUDE_DIRS]) Tj
T*
(        for filename in filenames:) Tj
T*
(            path = Path\(dirpath\) / filename) Tj
T*
(            if path.suffix.lower\(\) in TEXT_EXTENSIONS:) Tj
T*
(                yield path) Tj
T*
() Tj
T*
() Tj
T*
(def escape_text\(text: str\) -> str:) Tj
T*
(    return text.replace\("\\\\", "\\\\\\\\"\).replace\("\(", "\\\\\("\).replace\("\)", "\\\\\)"\)) Tj
T*
() Tj
T*
() Tj
T*
(def chunk_lines\(lines: List[str], size: int\) -> List[List[str]]:) Tj
T*
(    return [lines[i : i + size] for i in range\(0, len\(lines\), size\)] or [[]]) Tj
T*
() Tj
T*
() Tj
T*
