T*
() Tj
T*
() Tj
T*
(class ServerDataManager:) Tj
T*
(    """서버 데이터 관리 클래스 \(Supabase 사용 - ERD 구조\)""") Tj
T*
(    ) Tj
T*
(    def __init__\(self\):) Tj
T*
(        self.supabase = supabase) Tj
T*
(        self.use_supabase = SUPABASE_AVAILABLE) Tj
T*
(        ) Tj
T*
(        if not self.use_supabase:) Tj
T*
(            print\("경고: Supabase를 사용할 수 없습니다. JSON 파일 모드로 폴백합니다."\)) Tj
T*
(            self._init_json_fallback\(\)) Tj
T*
(        else:) Tj
T*
