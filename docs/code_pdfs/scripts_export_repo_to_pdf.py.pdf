(        content_obj_num = len\(objects\) + 1) Tj
T*
(        content_objs.append\(content_obj_num\)) Tj
T*
(        objects.append\(f"<< /Length {len\(content_bytes\)} >>\\nstream\\n{content}\\nendstream"\)) Tj
T*
() Tj
T*
(        page_obj_num = len\(objects\) + 1) Tj
T*
(        page_objs.append\(page_obj_num\)) Tj
