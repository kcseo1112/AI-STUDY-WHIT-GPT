T*
(STT_AVAILABLE = OPENAI_AVAILABLE) Tj
T*
(STT_ERROR = OPENAI_ERROR) Tj
T*
() Tj
T*
() Tj
T*
(def transcribe_audio\(file_path, language=None, model_name=None\):) Tj
T*
(    """오디오 파일을 텍스트로 변환 \(OpenAI Whisper API\)""") Tj
T*
(    if not OPENAI_AVAILABLE or not openai_client:) Tj
T*
(        raise RuntimeError\(f"OpenAI API를 사용할 수 없습니다: {OPENAI_ERROR}"\)) Tj
T*
(    ) Tj
T*
(    if not os.path.exists\(file_path\):) Tj
T*
(        raise FileNotFoundError\(f"파일을 찾을 수 없습니다: {file_path}"\)) Tj
T*
(    ) Tj
T*
(    # 파일 크기 확인 \(OpenAI Whisper API는 25MB 제한\)) Tj
T*
(    file_size = os.path.getsize\(file_path\)) Tj
T*
(    max_size = 25 * 1024 * 1024  # 25MB) Tj
T*
(    if file_size > max_size:) Tj
T*
(        raise ValueError\(f"파일 크기가 너무 큽니다 \({file_size / 1024 / 1024:.2f}MB\). 최대 25MB까지 지원됩니다."\)) Tj
T*
(    ) Tj
T*
(    # OpenAI Whisper API 사용) Tj
T*
(    # language 파라미터는 ISO 639-1 형식 \(예: 'ko', 'en'\)) Tj
T*
(    # model은 'whisper-1'만 사용 가능 \(기본값\)) Tj
T*
ET
