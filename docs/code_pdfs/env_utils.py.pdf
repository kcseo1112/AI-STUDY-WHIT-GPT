T*
(OPENAI_MODEL = get_openai_model\(\)) Tj
T*
(WHISPER_MODEL = get_whisper_model\(\)) Tj
T*
(WHISPER_LANGUAGE = get_whisper_language\(\)) Tj
T*
() Tj
T*
