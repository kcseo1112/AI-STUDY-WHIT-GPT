T*
(                self.handlers.load_file_list\(\)) Tj
T*
(            else:) Tj
T*
(                self.ui.server_status_label.config\() Tj
T*
(                    text=f"연결 상태: 연결 실패 \({DEFAULT_HOST}:{DEFAULT_PORT}\)", ) Tj
T*
(                    fg='red') Tj
T*
(                \)) Tj
