T*
(        from openai import OpenAI) Tj
T*
(        # 타임아웃 설정: STT 처리는 큰 파일의 경우 시간이 걸릴 수 있음) Tj
T*
(        # connect timeout: 10초, read timeout: 300초 \(5분\)) Tj
T*
(        import httpx) Tj
T*
(        openai_client = OpenAI\() Tj
T*
(            api_key=OPENAI_API_KEY,) Tj
T*
(            timeout=httpx.Timeout\(10.0, read=300.0\)  # 연결 10초, 읽기 5분) Tj
T*
(        \)) Tj
T*
(        OPENAI_AVAILABLE = True) Tj
T*
(        OPENAI_ERROR = None) Tj
T*
(    else:) Tj
T*
(        openai_client = None) Tj
T*
(        OPENAI_AVAILABLE = False) Tj
T*
(        OPENAI_ERROR = "OPENAI_API_KEY 환경 변수가 설정되어 있지 않습니다.") Tj
T*
(except ImportError:) Tj
T*
(    openai_client = None) Tj
T*
(    OPENAI_AVAILABLE = False) Tj
T*
(    OPENAI_ERROR = "openai 모듈을 찾을 수 없습니다.") Tj
T*
(except Exception as e:) Tj
T*
(    openai_client = None) Tj
T*
(    OPENAI_AVAILABLE = False) Tj
T*
(    OPENAI_ERROR = str\(e\)) Tj
T*
() Tj
T*
