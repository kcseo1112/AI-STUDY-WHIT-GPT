T*
(│   ├── server_core.py   # 서버 핵심 기능) Tj
T*
(│   ├── server_data_supabase.py  # Supabase 데이터 관리) Tj
T*
(│   ├── server_data.py   # JSON 폴백 데이터 관리) Tj
T*
(│   ├── server_gui.py    # 서버 GUI) Tj
T*
(│   └── server_handlers.py  # 서버 명령 처리) Tj
T*
