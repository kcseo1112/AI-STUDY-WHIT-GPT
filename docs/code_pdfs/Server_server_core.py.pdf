T*
(                return self.handlers.handle_save_score\(data\)) Tj
T*
(            elif command == "generate_quiz":) Tj
T*
(                return self.handlers.handle_generate_quiz\(data\)) Tj
T*
(            elif command == "generate_single_quiz":) Tj
T*
(                return self.handlers.handle_generate_single_quiz\(data\)) Tj
T*
(            elif command == "load_quizzes":) Tj
T*
(                return self.handlers.handle_load_quizzes\(data\)) Tj
T*
(            elif command == "list_files":) Tj
T*
(                return self.handlers.handle_list_files\(data\)) Tj
T*
(            elif command == "analyze_text":) Tj
T*
(                return self.handlers.handle_analyze_text\(data\)) Tj
T*
(            else:) Tj
T*
(                return {"status": "error", "message": f"알 수 없는 명령: {command}"}) Tj
T*
(        except Exception as e:) Tj
T*
(            return {"status": "error", "message": str\(e\)}) Tj
T*
(    ) Tj
T*
