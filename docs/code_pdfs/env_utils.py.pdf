(Path: env_utils.py) Tj
T*
(# env_utils.py) Tj
T*
(# 환경 변수 유틸리티 모듈 \(.env 파일에서 읽기\)) Tj
T*
() Tj
T*
(import os) Tj
T*
() Tj
T*
(# .env 파일에서 환경 변수 로드) Tj
T*
(def load_env_file\(\):) Tj
T*
(    """.env 파일에서 환경 변수 로드""") Tj
T*
(    env_path = os.path.join\(os.path.dirname\(os.path.abspath\(__file__\)\), '.env'\)) Tj
T*
(    if os.path.exists\(env_path\):) Tj
T*
(        try:) Tj
T*
(            with open\(env_path, 'r', encoding='utf-8'\) as f:) Tj
T*
(                for line in f:) Tj
T*
(                    line = line.strip\(\)) Tj
T*
(                    # 주석이나 빈 줄 무시) Tj
T*
(                    if not line or line.startswith\('#'\):) Tj
T*
(                        continue) Tj
T*
(                    # KEY=VALUE 형식 파싱) Tj
T*
(                    if '=' in line:) Tj
T*
(                        key, value = line.split\('=', 1\)) Tj
T*
(                        key = key.strip\(\)) Tj
T*
(                        value = value.strip\(\).strip\('"'\).strip\("'"\)) Tj
T*
(                        os.environ[key] = value) Tj
T*
(        except Exception as e:) Tj
T*
(            print\(f"환경 변수 파일 로드 오류: {e}"\)) Tj
T*
() Tj
T*
(# .env 파일 로드) Tj
T*
(load_env_file\(\)) Tj
T*
() Tj
T*
(# 환경 변수 읽기 함수들 \(.env 파일에서만 읽기\)) Tj
T*
(def get_default_host\(\):) Tj
T*
(    value = os.getenv\('DEFAULT_HOST'\)) Tj
T*
(    if value is None:) Tj
T*
(        raise ValueError\("DEFAULT_HOST가 .env 파일에 설정되어 있지 않습니다."\)) Tj
T*
(    return value) Tj
T*
() Tj
T*
(def get_default_port\(\):) Tj
T*
(    value = os.getenv\('DEFAULT_PORT'\)) Tj
T*
(    if value is None:) Tj
T*
(        raise ValueError\("DEFAULT_PORT가 .env 파일에 설정되어 있지 않습니다."\)) Tj
T*
(    return int\(value\)) Tj
T*
() Tj
T*
(def get_bufsize\(\):) Tj
T*
(    value = os.getenv\('BUFSIZE'\)) Tj
T*
(    if value is None:) Tj
T*
(        raise ValueError\("BUFSIZE가 .env 파일에 설정되어 있지 않습니다."\)) Tj
T*
(    return int\(value\)) Tj
T*
() Tj
T*
(def get_receive_dir\(\):) Tj
T*
(    value = os.getenv\('RECEIVE_DIR'\)) Tj
T*
(    if value is None:) Tj
T*
(        raise ValueError\("RECEIVE_DIR이 .env 파일에 설정되어 있지 않습니다."\)) Tj
T*
(    return value) Tj
T*
() Tj
T*
ET
endstream
