T*
(# Supabase 클라이언트 모듈) Tj
T*
() Tj
T*
(import os) Tj
T*
(import sys) Tj
T*
(sys.path.append\(os.path.dirname\(os.path.abspath\(__file__\)\)\)) Tj
T*
() Tj
T*
(try:) Tj
T*
(    from supabase import create_client, Client) Tj
T*
(    SUPABASE_MODULE_AVAILABLE = True) Tj
T*
(except ImportError:) Tj
T*
(    SUPABASE_MODULE_AVAILABLE = False) Tj
T*
(    print\("경고: supabase 모듈을 찾을 수 없습니다. pip install supabase 실행하세요."\)) Tj
T*
(    Client = None) Tj
T*
() Tj
T*
(# env_utils.py에서 환경 변수 로드) Tj
T*
(from env_utils import SUPABASE_URL, SUPABASE_ANON_KEY) Tj
T*
() Tj
T*
(# Supabase 클라이언트 초기화) Tj
T*
(supabase: Client | None = None) Tj
T*
() Tj
T*
(if SUPABASE_MODULE_AVAILABLE and SUPABASE_URL and SUPABASE_ANON_KEY:) Tj
T*
(    try:) Tj
T*
(        supabase = create_client\(SUPABASE_URL, SUPABASE_ANON_KEY\)) Tj
T*
(        print\("Supabase 클라이언트 초기화 완료"\)) Tj
T*
(    except Exception as e:) Tj
T*
(        print\(f"Supabase 클라이언트 초기화 실패: {e}"\)) Tj
T*
(        supabase = None) Tj
T*
(else:) Tj
T*
(    if not SUPABASE_MODULE_AVAILABLE:) Tj
T*
(        print\("경고: supabase 모듈이 설치되지 않았습니다."\)) Tj
T*
(    elif not SUPABASE_URL or not SUPABASE_ANON_KEY:) Tj
T*
(        print\("경고: Supabase 설정이 .env 파일에 없습니다."\)) Tj
T*
(    supabase = None) Tj
T*
() Tj
T*
(SUPABASE_AVAILABLE = supabase is not None) Tj
T*
() Tj
T*
