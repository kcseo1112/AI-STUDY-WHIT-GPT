(        if self.use_supabase:) Tj
T*
(            try:) Tj
T*
(                result = self.supabase.table\('Folder'\).select\('*'\).eq\('email', email\).execute\(\)) Tj
T*
(                return result.data if result.data else []) Tj
T*
(            except Exception as e:) Tj
T*
(                print\(f"폴더 조회 오류: {e}"\)) Tj
T*
(                return []) Tj
T*
(        else:) Tj
T*
(            folders = []) Tj
T*
(            for folder_id, folder_data in self._folders.items\(\):) Tj
T*
(                if folder_data.get\('email'\) == email:) Tj
T*
(                    folders.append\(folder_data\)) Tj
T*
(            return folders) Tj
T*
(    ) Tj
T*
