(    def handle_client\(self, conn, addr\):) Tj
T*
(        """클라이언트 요청 처리""") Tj
T*
(        try:) Tj
T*
(            with conn:) Tj
T*
(                # STT 처리는 OpenAI API 호출로 시간이 걸릴 수 있으므로 타임아웃 증가) Tj
T*
(                conn.settimeout\(300.0\)  # 5분 타임아웃 \(STT 처리 시간 고려\)) Tj
T*
(                ) Tj
T*
(                # 먼저 4바이트를 읽어서 명령 메시지인지 확인) Tj
T*
(                length_bytes = conn.recv\(4, socket.MSG_PEEK\)) Tj
T*
(                ) Tj
T*
(                if len\(length_bytes\) == 4:) Tj
T*
(                    # 4바이트가 모두 0-255 범위의 숫자이고 합리적인 크기면 명령일 가능성) Tj
T*
(                    try:) Tj
T*
(                        message_length = int.from_bytes\(length_bytes, byteorder='big'\)) Tj
T*
(                        # 명령 메시지는 보통 1KB 이하이므로, 100KB 이하면 명령으로 간주) Tj
T*
(                        if message_length > 0 and message_length < 100000:) Tj
T*
ET
