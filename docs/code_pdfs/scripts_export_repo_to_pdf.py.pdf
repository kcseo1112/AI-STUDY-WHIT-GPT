T*
() Tj
T*
(    # Pages object) Tj
T*
(    pages_obj_num = len\(objects\) + 1) Tj
T*
(    kids = " ".join\(f"{num} 0 R" for num in page_objs\)) Tj
T*
(    objects.append\(f"<< /Type /Pages /Kids [{kids}] /Count {len\(page_objs\)} >>"\)) Tj
T*
() Tj
T*
(    # Replace parent references now that pages object number is known) Tj
